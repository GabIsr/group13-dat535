# Socrata NYC Open Data API Application Token (Optional for small queries, recommended for production)
SOCRATA_APP_TOKEN=your_socrata_app_token_here

# Pipeline Environment (dev, staging, prod)
DAT535_ENV=dev

# Project Universe / Ingestion Floor Boundary (Change Data Capture lower bound)
DAT535_PROJECT_START_DATE=2026-07-15T00:00:00.000

# Optional: Override Root Output Directory (Defaults to <project_root>/data if unset)
# DAT535_OUTPUT_DIR=/path/to/custom/data/storage
